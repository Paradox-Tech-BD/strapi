HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Use strong, unique values in production. APP_KEYS must include at least two comma-separated keys.
APP_KEYS="local-development-key-1,local-development-key-2"
API_TOKEN_SALT=local-development-api-token-salt
ADMIN_JWT_SECRET=local-development-admin-jwt-secret
TRANSFER_TOKEN_SALT=local-development-transfer-token-salt
JWT_SECRET=local-development-jwt-secret
ENCRYPTION_KEY=local-development-encryption-key

# Set this to the permanent external base URL when deploying behind HTTPS.
# PUBLIC_URL=https://inventel-api.example.com
IS_PROXIED=false

# Comma-separated origins allowed to call the public catalogue API.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Local development defaults to SQLite. Use a managed Postgres database in production.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
